# ============================================================
# Socorro! — Configuração de produção
# ============================================================

# Banco de Dados (Neon PostgreSQL)
# Pode colar a URL exatamente como o painel do Neon fornece.
# A aplicação normaliza para o driver asyncpg e ativa SSL automaticamente.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require
# true = força SSL (Neon). Deixe vazio para detetar automaticamente.
DATABASE_SSL=true

# JWT
SECRET_KEY=change-me-in-production-use-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS / frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://socorro-phi.vercel.app
FRONTEND_URL=https://socorro-phi.vercel.app

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Pagamento (sandbox)
MULTICAIXA_API_KEY=
MULTICAIXA_SECRET=
UNITEL_MONEY_API_KEY=
AFRIMONEY_API_KEY=

# SMS (Africa's Talking)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# Redis (opcional — necessário para recuperação de password)
REDIS_URL=
