# Banco de Dados (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb

# JWT
SECRET_KEY=change-me-in-production-use-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://socorro-phi.vercel.app

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Pagamento (sandbox)
MULTICAIXA_API_KEY=
MULTICAIXA_SECRET=
UNITEL_MONEY_API_KEY=
AFRIMONEY_API_KEY=

# SMS (Africa's Talking)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# Redis (para cache e WebSockets)
REDIS_URL=redis://redis:6379/0
